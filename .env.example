# ============================================================
# Go Dr — environment variable template
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file. Real secrets must stay local
# or in your hosting provider's secret manager.
# ============================================================

# ---- App ----
NODE_ENV=development
APP_NAME="Go Dr"
# Comma-separated list of allowed CORS origins (dev only)
APP_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Local dev (Docker) example:
DATABASE_URL="postgresql://godr:godr_dev_password@localhost:5432/godr?schema=public"
# Production example (use a managed Postgres + strong password):
# DATABASE_URL="postgresql://USER:STRONG_PASSWORD@HOST:5432/DB?schema=public"

# ---- Auth / JWT ----
# Generate a long random string, e.g.: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Bcrypt ----
# Cost factor for password hashing (10–12 is reasonable)
BCRYPT_COST=12

# ---- Seed (development admin) ----
# Used only by `npm run db:seed` to create a dev admin account.
# The password is hashed with bcrypt before being stored.
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL=admin@godr.bd
SEED_ADMIN_PHONE=01700000000
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
